  },
  "modal_heading": {
    "xpath": "//h2[text()='Submission Received']",
    "type": "heading",
    "action": "assert",
    "result": "modal heading exactly matches 'Submission Received'"
  },
  "modal_message": {
    "xpath": "//p[text()='Your case submission has been received successfully.']",
    "type": "text",
    "action": "assert",
