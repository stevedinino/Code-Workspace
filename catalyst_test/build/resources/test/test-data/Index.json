  },
  "modal_ok_button": {
    "xpath": "//button[@id='confirmButton']",
    "type": "button",
    "action": "click",
    "result": "closes modal and redirects to 'index.html'"
  },
  "footer": {
    "xpath": "//footer",
    "type": "container",
    "action": "assert",
    "result": "footer is visible at bottom of page"
  },
  "footer_copyright": {
    "xpath": "//footer//p",
    "type": "text",
    "action": "assert",
    "result": "copyright text contains 'Catalyst Legal Nurse Consulting of SC, LLC'"
  },
  "copyright_text": {
    "xpath": "//p[contains(text(), '2025 Catalyst Legal Nurse Consulting of SC, LLC')]",
    "type": "text",
    "action": "assert",
