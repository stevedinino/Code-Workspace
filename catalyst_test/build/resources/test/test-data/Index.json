{
  "title": {
    "xpath": "//title",
    "type": "text",
    "action": "assert",
    "result": "text equals 'Janet DiNino – Legal Nurse Consultant for Elder Care Litigation'"
  },
  "meta_description": {
    "xpath": "//meta[@name='description']",
    "type": "metadata",
    "action": "assert",
    "result": "content attribute contains 'Board-certified NP and legal nurse consultant offering expert case reviews in elder care, wound management, and compliance litigation.'"
  },
  "meta_keywords": {
    "xpath": "//meta[@name='keywords']",
    "type": "metadata",
    "action": "assert",
    "result": "content attribute contains 'legal nurse consultant, elder care litigation, wound care expert'"
  },
  "link_favicon": {
    "xpath": "//link[@rel='icon']",
    "type": "resource",
    "action": "assert",
    "result": "element exists in DOM"
  },
  "script_schema_json": {
    "xpath": "//script[@type='application/ld+json']",
    "type": "script",
    "action": "assert",
    "result": "Schema.org JSON-LD for MedicalOrganization is present"
  },
  "header": {
    "xpath": "//header",
    "type": "container",
    "action": "assert",
    "result": "header is visible in viewport"
  },
  "logo_container": {
    "xpath": "//header//div[@class='logo']",
    "type": "container",
    "action": "assert",
    "result": "logo container is visible"
  },
  "logo_link": {
    "xpath": "//header//a[@href='index.html']",
    "type": "link",
    "action": "click",
    "result": "navigates to 'index.html' (home page)"
  },
  "logo_image": {
    "xpath": "//header//img[@alt='Catalyst Logo']",
    "type": "image",
    "action": "assert",
    "result": "logo image is displayed and has alt text 'Catalyst Logo'"
  },
  "nav_wrapper": {
    "xpath": "//header//div[@class='nav-wrapper']",
    "type": "container",
    "action": "assert",
    "result": "navigation wrapper is visible"
  },
  "menu_toggle_button": {
    "xpath": "//header//button[@class='menu-toggle']",
    "type": "button",
    "action": "click",
    "result": "toggles visibility of mobile navigation menu (class 'active' added/removed from .nav-links)"
  },
  "main_nav": {
    "xpath": "//nav[@class='main-nav']",
    "type": "container",
    "action": "assert",
    "result": "main navigation is visible on desktop; hidden on mobile until toggle"
  },
  "nav_links_list": {
    "xpath": "//ul[@class='nav-links']",
    "type": "list",
    "action": "assert",
    "result": "navigation list is visible (on desktop or after mobile toggle)"
  },
  "nav_about_li": {
    "xpath": "//li[a[text()='About']]",
    "type": "list-item",
    "action": "assert",
    "result": "About menu item is visible"
  },
  "nav_about_link": {
    "xpath": "//a[text()='About']",
    "type": "link",
    "action": "click",
    "result": "navigates to 'about.html'"
  },
  "nav_services_li": {
    "xpath": "//li[a[text()='Services']]",
    "type": "list-item",
    "action": "assert",
