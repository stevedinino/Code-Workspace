  },
  "confirmation_modal": {
    "xpath": "//div[@id='confirmationModal']",
    "type": "modal",
    "action": "assert",
    "result": "modal is visible when URL contains '?success=1'"
  },
  "modal_content": {
    "xpath": "//div[@class='modal-content']",
    "type": "container",
    "action": "assert",
